<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for API and image requests in release builds. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Required for local reading reminders (runtime request on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="Alana"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Supabase menyimpan sesi dan refresh token di keystore lewat
                 flutter_secure_storage. Kunci AES-nya tinggal di Android
                 Keystore dan tidak ikut ter-backup ke Google Drive, jadi
                 prefs yang terenkripsi tidak boleh ikut disalin. Kalau ikut,
                 hasil restore ke perangkat lain tidak bisa di-unwrap lagi dan
                 aplikasi gagal membaca sesi dengan
                 "InvalidKeyException: Failed to unwrap key".

                 allowBackup="false" dipilih, bukan sekadar mengecualikan
                 prefs miliknya: Hive juga menyimpan box downloads yang bisa
                 ratusan MB, dan auto-backup akan diam-diam gagal karena
                 kuota. Bookmark dan reading progress sudah disinkronkan ke
                 Supabase, jadi yang hilang dari backup hanyalah setelan
                 lokal. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="alana"/>
                <data android:host="manga"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="alana"/>
                <data android:host="chapter"/>
            </intent-filter>
            <!-- Tautan reset password dari Supabase. Tanpa filter ini, email
                 "lupa password" hanya bisa dibuka di browser dan sesi recovery
                 tidak pernah sampai ke aplikasi. URI ini juga wajib
                 ditambahkan ke Authentication > Redirect URL di dashboard
                 Supabase, kalau tidak Supabase tidak akan mengirim tautan. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="alana"/>
                <data android:host="reset-password"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
