{
  "name": "Flutter Dev Container",
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Ekstensi VS Code yang otomatis terpasang di Codespace
  "customizations": {
    "vscode": {
      "extensions": ["Dart-Code.flutter", "Dart-Code.dart-code"],
      "settings": {
        "dart.flutterSdkPath": "/opt/flutter"
      }
    }
  },

  // Port yang biasa dipakai flutter run -d web-server / DevTools
  "forwardPorts": [8080, 9100],

  // Jalan sekali saat container pertama kali dibuat
  "postCreateCommand": "flutter doctor -v",

  // User non-root bawaan image
  "remoteUser": "vscode"
}
